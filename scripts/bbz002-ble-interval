#!/bin/sh
# Pin a BBZ002's Bluetooth LE connection interval to a fixed value.
# The keyboard asks for 15-30 ms after connecting and the controller picks
# 30 ms, which makes touchpad motion steppy. Started by the udev rule with the
# keyboard's address, e.g. ee:a7:1d:1a:ef:00.
set -eu

# Connection interval in units of 1.25 ms: 9 = 11.25 ms, just under the
# touchpad's ~11.6 ms report period, so reports rarely arrive in pairs.
interval=9

address=$(printf '%s' "$1" | tr a-f A-F)

# Wait for the keyboard's own parameter request, then override it. Try again
# in case the request comes late.
for delay in 5 10; do
	sleep "$delay"
	handle=$(hcitool con | awk -v address="$address" '$3 == address { print $5 }')
	[ -n "$handle" ] || exit 0
	hcitool lecup --handle "$handle" --min "$interval" --max "$interval" \
		--latency 23 --timeout 430
done
